{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-result.schema.json",
  "title": "ValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "usable",
    "reason",
    "state",
    "masked_code",
    "remaining_uses",
    "required_access_level",
    "expires_at"
  ],
  "properties": {
    "usable": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "GENERATED",
        "ACTIVE",
        "EXHAUSTED",
        "EXPIRED",
        "REVOKED",
        null
      ]
    },
    "masked_code": {
      "type": "string",
      "minLength": 1
    },
    "remaining_uses": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "required_access_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
